# nullbook configuration
# Copy to .env and fill in your values

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Admin user (change these before running `make setup`)
NULLBOOK_ADMIN_USER=admin
NULLBOOK_ADMIN_PASSWORD=nullbook-local

# Database (leave blank for SQLite)
DATABASE_URL=

# Redis (for Celery background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# AI provider: 'anthropic' (default), 'openai', or 'ollama' (local, opt-in)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
CHAT_MODEL=claude-opus-4-6
CHAT_MODEL_FAST=claude-haiku-4-5-20251001
VISION_MODEL=claude-sonnet-4-6

# Only needed if LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# CHAT_MODEL=gpt-4.1
# CHAT_MODEL_FAST=gpt-4.1-mini
# VISION_MODEL=gpt-4.1

# Only needed if LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=qwen3:8b
# CHAT_MODEL_FAST=qwen3:4b
# VISION_MODEL=qwen3:8b

# Plaid (optional — for bank account syncing)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Email scanning (optional — for Gmail receipt scanning via IMAP)
# See docs/integrations.md for setup instructions
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Email (optional — for subscription cancellation)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
